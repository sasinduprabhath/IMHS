# MySQL Database Connection URL
DATABASE_URL="mysql://root:password@localhost:3306/imhs_db"

# NextAuth Secret for JWT Encryption (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-32-character-secret-key-here"

# NextAuth Base URL
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Administrative Contact Number
NEXT_PUBLIC_WHATSAPP_NUMBER="+94778025050"

# Google Drive Storage Integration (OAuth2 or Service Account + Folder ID)
GOOGLE_DRIVE_FOLDER_ID="1YOUR_GOOGLE_DRIVE_FOLDER_ID_HERE"

# Option A: Google OAuth2 Refresh Token (Recommended for personal @gmail.com accounts)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
GOOGLE_REFRESH_TOKEN="1//04your-refresh-token"

# Option B: Google Service Account (For Shared Drives or Google Workspace)
GOOGLE_SERVICE_ACCOUNT_EMAIL="imhs-uploads@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
