# ==============================================================================
# IMHS PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE CONFIGURATION (CyberPanel MySQL)
# Format: mysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/<DB_NAME>?connection_limit=15&pool_timeout=20
DATABASE_URL="mysql://imhs_user:YourStrongPassword123!@127.0.0.1:3306/imhs_db?connection_limit=15&pool_timeout=20"

# 2. NEXTAUTH & AUTHENTICATION (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-base64-secret"
NEXTAUTH_URL="https://imhsedu.com"

# 3. FIELD-LEVEL ENCRYPTION AT REST (AES-256-GCM & Blind Index)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET="generate-a-strong-64-character-hex-encryption-key"
# Generate with: openssl rand -hex 16
BLIND_INDEX_SALT="generate-a-strong-32-character-hex-salt"

# 4. EMAIL / TRANSACTIONAL OTP MAILER (Gmail App Password or SMTP)
GMAIL_USER="info.imhsedu@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"

# 5. GOOGLE GEMINI AI (For Medical Tutor & Clinical Case Simulation)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 6. WHATSAPP & PUBLIC CHANNELS
NEXT_PUBLIC_WHATSAPP_NUMBER="+94778025050"

# 7. GOOGLE DRIVE BACKUP & STORAGE (Optional)
GOOGLE_DRIVE_FOLDER_ID="1YourGoogleDriveFolderIdHere"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
GOOGLE_REFRESH_TOKEN="1//04your-refresh-token"
# Optional Service Account Alternative:
GOOGLE_SERVICE_ACCOUNT_EMAIL="imhs-uploads@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# 8. ENVIRONMENT MODE & RUNTIME PORT
NODE_ENV="production"
PORT=3020
