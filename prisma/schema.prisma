generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  studentId        String?   @unique // e.g. "IWPH4131"
  name             String
  email            String    @unique
  phone            String
  passwordHash     String
  role             String    @default("STUDENT") // "ADMIN" | "STUDENT"
  status           String    @default("ACTIVE")  // "ACTIVE" | "FROZEN"
  hasCompletedTour Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ─ Device Binding ───────────────────────────────────────
  deviceSignature  String?   // SHA-256 of hardware fingerprint
  deviceLockedAt   DateTime? // When the device was first registered

  // ─ Email 2FA ──────────────────────────────────────────
  otpCode          String?   // Bcrypt-hashed 6-digit OTP
  otpExpiry        DateTime? // OTP expires 10 min after generation
  otpAttempts      Int       @default(0) // Failed OTP attempt counter

  devices          StudentDevice[]
  enrollments      Enrollment[]
  progress         LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]
  activityLogs     StudentActivityLog[]
  gameLeaderboards PharmacyRushLeaderboard[]
  courseAssessmentResults CourseAssessmentResult[]
  sentMessages     DirectMessage[] @relation("SentDirectMessages")
  receivedMessages DirectMessage[] @relation("ReceivedDirectMessages")
}

model StudentDevice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSignature String   // SHA-256 fingerprint
  deviceInfo      String?  // Browser/OS/device summary
  status          String   @default("BLOCKED") // "PRIMARY" | "ALLOWED" | "BLOCKED"
  lastAttemptAt   DateTime @default(now())
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Course {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String   @db.Text
  price              Float    @default(0.0)
  originalPrice      Float?
  type               String   @default("Course") // "Course" | "Bundle"
  category           String   @default("Modern Pharmacy")
  level              String   @default("All Levels") // "All Levels" | "Beginner" | "Intermediate" | "Expert"
  enrollmentValidity String   @default("Lifetime Access")
  totalEnrolled      Int      @default(450)
  published          Boolean  @default(false)
  coverImage         String?
  createdAt          DateTime @default(now())

  chapters           Chapter[]
  enrollments        Enrollment[]
  announcements      CourseAnnouncement[]
  instructors        CourseInstructor[]
  assignments        Assignment[]
  assessmentQuestions ModuleAssessmentQuestion[]
  assessmentResults  CourseAssessmentResult[]
}

model Chapter {
  id       String @id @default(cuid())
  title    String
  order    Int
  isLocked Boolean @default(false)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons     Lesson[]
  assignments Assignment[]
}

model Lesson {
  id           String  @id @default(cuid())
  title        String
  order        Int
  type         String  @default("VIDEO") // "VIDEO" | "DOCUMENT" | "QUIZ"
  isLocked     Boolean @default(false)
  vimeoVideoId String?
  driveFileId  String?
  content      String? @db.Text
  chapterId    String
  chapter      Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  progress     LessonProgress[]
}

model CourseAnnouncement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CourseInstructor {
  id              String        @id @default(cuid())
  courseId        String
  facultyMemberId String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyMember   FacultyMember @relation(fields: [facultyMemberId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyMemberId])
}

model Enrollment {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  status            String   @default("ACTIVE") // "ACTIVE" | "FROZEN"
  blockedChapterIds String?  @db.Text           // JSON array string of blocked chapter IDs
  blockedLessonIds  String?  @db.Text           // JSON array string of blocked lesson IDs
  enrolledAt        DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  courseTaken String?
  quote       String   @db.Text
  photoUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model FacultyMember {
  id       String @id @default(cuid())
  name     String
  title    String
  bio      String @db.Text
  photoUrl String?
  order    Int    @default(0)

  instructors CourseInstructor[]
}

model ContactInquiry {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String?
  courseInterest  String?
  message         String   @db.Text
  createdAt       DateTime @default(now())
  resolved        Boolean  @default(false)
}

model ConsultationBooking {
  id            String        @id @default(cuid())
  bookingCode   String        @unique
  studentName   String
  studentEmail  String
  studentPhone  String
  sessionType   String        // "MENTORSHIP" | "CLINICAL_CONSULTATION" | "MOCK_INTERVIEW"
  durationMins  Int           // 30, 45, 60
  priceLkr      Float         @default(0)
  bookingDate   DateTime
  timeSlot      String        // e.g. "10:00 AM"
  topicNotes    String?       @db.Text
  status        BookingStatus @default(PENDING)
  meetingLink   String?
  adminNotes    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingDate])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─ Assignment Submission & Evaluation Module ─────────────────
model Assignment {
  id               String   @id @default(cuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId        String?
  chapter          Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  title            String
  description      String   @db.Text
  attachmentUrl    String?  // Brief PDF or reference document URL
  dueDate          DateTime
  maxMarks         Int      @default(100)
  allowLate        Boolean  @default(false)
  allowedFileTypes String   @default("PDF,DOCX,ZIP")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submissions      AssignmentSubmission[]

  @@index([courseId])
  @@index([dueDate])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  fileSize     Int?
  status       String     @default("SUBMITTED") // "SUBMITTED" | "LATE" | "GRADED"
  score        Int?
  feedback     String?    @db.Text
  gradedAt     DateTime?
  gradedBy     String?
  submittedAt  DateTime   @default(now())

  @@unique([assignmentId, userId])
  @@index([userId])
}

// ─── IMHS Interactive Learning Hub & Admin CMS Models ─────────

model Module {
  id           String                     @id @default(cuid())
  title        String
  code         String                     @unique
  description  String?                    @db.Text
  tfQuestions  ModuleAssessmentQuestion[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model PrescriptionCase {
  id                String   @id @default(cuid())
  title             String
  imageUrl          String   @db.Text
  patientDetails    Json     // { name, age, sex, date, diagnosis }
  medicineDetails   Json     // Array of { name, strength, dose, frequency, duration }
  hasProblem        Boolean  @default(false)
  problemOptions    Json     // Options presented to student
  correctProblem    String?  @db.Text
  shouldDispense    Boolean  @default(true)
  dispenseReason    String   @db.Text
  counsellingPoints Json     // Array of correct counselling points
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DrugKnowledge {
  id                 String   @id @default(cuid())
  genericName        String   @unique
  drugClass          String
  drugClassOptions   Json     // Array of strings
  mechanismOfAction  String   @db.Text
  moaOptions         Json     // Array of strings
  sideEffects        Json     // Array of strings
  sideEffectOptions  Json     // Array of strings
  interactions       Json     // Array of strings
  interactionOptions Json     // Array of strings
  antidote           String?  @db.Text
  antidoteOptions    Json?    // Array of strings
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ModuleAssessmentQuestion {
  id          String   @id @default(cuid())
  moduleId    String?
  module      Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question    String   @db.Text
  isTrue      Boolean
  explanation String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([moduleId])
  @@index([courseId])
}

model CourseAssessmentResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score       Int
  maxScore    Int
  percentage  Float
  passed      Boolean  @default(false)
  completedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model PharmacyRushConfig {
  id              String              @id @default(cuid())
  medicineName    String
  isActive        Boolean             @default(true)
  timePerRoundSec Int                 @default(15)
  rounds          PharmacyRushRound[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PharmacyRushRound {
  id            String             @id @default(cuid())
  configId      String
  config        PharmacyRushConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  roundNumber   Int
  challengeType String
  questionText  String             @db.Text
  options       Json               // Array of 4 strings
  correctOption String             @db.Text
  pointsValue   Int                @default(10)

  @@index([configId])
}

model StudentActivityLog {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityType String   // "PRESCRIPTION_REVIEW", "DRUG_CLASS", "MODULE_ASSESSMENT", "PHARMACY_RUSH"
  referenceId  String?
  score        Int
  maxScore     Int      @default(100)
  completedAt  DateTime @default(now())

  @@index([studentId])
  @@index([activityType])
}

model PharmacyRushLeaderboard {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  medicineName String
  score        Int
  timeTakenSec Int
  playedAt     DateTime @default(now())

  @@index([studentId])
  @@index([score])
}

model DirectMessage {
  id             String   @id @default(cuid())
  senderId       String
  sender         User     @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User     @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  studentId      String   // The student ID whose conversation thread this message belongs to
  content        String   @db.Text
  attachmentUrl  String?  @db.Text
  attachmentName String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model AchievementHighlight {
  id           String   @id @default(cuid())
  youtubeId    String   // YouTube Video ID (e.g., "TM1nTXW2Ogs")
  title        String
  category     String   @default("Convocation")
  duration     String?  // e.g. "12m 08s"
  views        String?  // e.g. "1.9K+ views"
  thumbnailUrl String?  @db.Text
  description  String?  @db.Text
  order        Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
  @@index([isPublished])
}

model GalleryItem {
  id           String   @id @default(cuid())
  type         String   @default("PHOTO") // "PHOTO" | "VIDEO"
  title        String
  category     String   @default("Campus Life") // "Convocation" | "Practicals" | "Workshops" | "Labs"
  mediaUrl     String   @db.Text
  thumbnailUrl String?  @db.Text
  description  String?  @db.Text
  tag          String?  // e.g. "BATCH 18 CONVOCATION"
  date         String?  // e.g. "2024"
  order        Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
  @@index([type])
  @@index([isPublished])
}


