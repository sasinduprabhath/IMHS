generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  studentId        String?   @unique // e.g. "IWPH4131"
  name             String
  email            String    @unique
  phone            String
  passwordHash     String
  role             String    @default("STUDENT") // "ADMIN" | "STUDENT"
  status           String    @default("ACTIVE")  // "ACTIVE" | "FROZEN"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ─ Device Binding ───────────────────────────────────────
  deviceSignature  String?   // SHA-256 of hardware fingerprint
  deviceLockedAt   DateTime? // When the device was first registered

  // ─ Email 2FA ──────────────────────────────────────────
  otpCode          String?   // Bcrypt-hashed 6-digit OTP
  otpExpiry        DateTime? // OTP expires 10 min after generation
  otpAttempts      Int       @default(0) // Failed OTP attempt counter

  enrollments      Enrollment[]
  progress         LessonProgress[]
}

model Course {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String   @db.Text
  price              Float    @default(0.0)
  originalPrice      Float?
  type               String   @default("Course") // "Course" | "Bundle"
  category           String   @default("Modern Pharmacy")
  level              String   @default("All Levels") // "All Levels" | "Beginner" | "Intermediate" | "Expert"
  enrollmentValidity String   @default("Lifetime Access")
  totalEnrolled      Int      @default(450)
  published          Boolean  @default(false)
  coverImage         String?
  createdAt          DateTime @default(now())

  chapters           Chapter[]
  enrollments        Enrollment[]
  announcements      CourseAnnouncement[]
  instructors        CourseInstructor[]
}

model Chapter {
  id       String @id @default(cuid())
  title    String
  order    Int
  isLocked Boolean @default(false)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons  Lesson[]
}

model Lesson {
  id           String  @id @default(cuid())
  title        String
  order        Int
  type         String  @default("VIDEO") // "VIDEO" | "DOCUMENT" | "QUIZ"
  isLocked     Boolean @default(false)
  vimeoVideoId String?
  driveFileId  String?
  content      String? @db.Text
  chapterId    String
  chapter      Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  progress     LessonProgress[]
}

model CourseAnnouncement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CourseInstructor {
  id              String        @id @default(cuid())
  courseId        String
  facultyMemberId String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyMember   FacultyMember @relation(fields: [facultyMemberId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyMemberId])
}

model Enrollment {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  status            String   @default("ACTIVE") // "ACTIVE" | "FROZEN"
  blockedChapterIds String?  @db.Text           // JSON array string of blocked chapter IDs
  blockedLessonIds  String?  @db.Text           // JSON array string of blocked lesson IDs
  enrolledAt        DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  courseTaken String?
  quote       String   @db.Text
  photoUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model FacultyMember {
  id       String @id @default(cuid())
  name     String
  title    String
  bio      String @db.Text
  photoUrl String?
  order    Int    @default(0)

  instructors CourseInstructor[]
}

model ContactInquiry {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String?
  courseInterest  String?
  message         String   @db.Text
  createdAt       DateTime @default(now())
  resolved        Boolean  @default(false)
}

model ConsultationBooking {
  id            String        @id @default(cuid())
  bookingCode   String        @unique
  studentName   String
  studentEmail  String
  studentPhone  String
  sessionType   String        // "MENTORSHIP" | "CLINICAL_CONSULTATION" | "MOCK_INTERVIEW"
  durationMins  Int           // 30, 45, 60
  priceLkr      Float         @default(0)
  bookingDate   DateTime
  timeSlot      String        // e.g. "10:00 AM"
  topicNotes    String?       @db.Text
  status        BookingStatus @default(PENDING)
  meetingLink   String?
  adminNotes    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingDate])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

